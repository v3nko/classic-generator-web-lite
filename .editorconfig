# EditorConfig configuration for classic-generator-web-lite
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2
max_line_length = 120

[*.{json,json5,webmanifest}]
indent_size = 2

[*.{html,htm}]
indent_size = 2
max_line_length = 120

[*.{css,scss,pcss}]
indent_size = 2

[*.{yaml,yml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false
max_line_length = off

[*.svg]
indent_size = 2

[*.bat]
end_of_line = crlf
